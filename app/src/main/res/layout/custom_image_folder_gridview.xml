<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/image_folder">

        <ImageView
            android:id="@+id/iv_gridview_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"

           />

        <TextView
            android:id="@+id/tv_gridview_folderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginLeft="@dimen/margin_thin"
            android:textSize="15dp"/>

        <TextView
            android:id="@+id/tv_gridview_folderSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B8A8A"
            android:layout_marginBottom="@dimen/margin_thin"
            android:layout_marginLeft="@dimen/margin_thin"
            android:textSize="15dp"/>


</LinearLayout>